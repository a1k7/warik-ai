# ---------------------------------------------------------------------------
# Warik AI — environment variable template
# Copy to backend/.env and fill in real values.
# NEVER commit the real .env file.
# ---------------------------------------------------------------------------

ENVIRONMENT=development
DATABASE_URL=sqlite:///./warik.db
CORS_ORIGINS=http://localhost:5173

# Auth — change JWT_SECRET to a long random string before deploying
JWT_SECRET=
# Generate a unique secret locally before production deployment.
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Gnani AI (backend-only — never expose to frontend)
# To enable voice, set VOICE_ENABLED=true AND paste your key below.
VOICE_ENABLED=false
GNANI_API_KEY=
GNANI_ORG_ID=
GNANI_USER_ID=
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_TTS_URL=https://api.gnani.ai/v1/tts/inference

# Voice usage protection
VOICE_MAX_UPLOAD_BYTES=5242880
VOICE_MAX_DURATION_SECONDS=30
VOICE_USAGE_LIMIT_SECONDS=300

# Ollama reasoning (free local option)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# LLM provider
# Use "ollama" for local development or "groq" for hosted deployment.
LLM_PROVIDER=ollama

# Local Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# Hosted Groq — keep the API key server-side
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile


# Swiggy OAuth — backend only; never expose credentials in frontend variables.
SWIGGY_MODE=mock
SWIGGY_CLIENT_ID=
SWIGGY_TOKEN_ENCRYPTION_KEY=
SWIGGY_REDIRECT_URI=http://localhost:8000/api/integrations/swiggy/oauth/callback
SWIGGY_FRONTEND_RETURN_URL=http://localhost:5173/settings
SWIGGY_AUTHORIZE_URL=https://mcp.swiggy.com/auth/authorize
SWIGGY_TOKEN_URL=https://mcp.swiggy.com/auth/token
SWIGGY_LOGOUT_URL=https://mcp.swiggy.com/auth/logout
SWIGGY_OAUTH_SCOPE=mcp:tools
