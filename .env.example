# ---------------------------------------------------------------------------
# Warik AI — environment variable template
# Copy to backend/.env and fill in real values.
# NEVER commit the real .env file.
# ---------------------------------------------------------------------------

ENVIRONMENT=development
DATABASE_URL=sqlite:///./warik.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Auth — set a unique local secret before using beyond development
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Gnani AI (backend-only — never expose to frontend)
VOICE_ENABLED=false
GNANI_API_KEY=
GNANI_ORG_ID=
GNANI_USER_ID=
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_TTS_URL=https://api.gnani.ai/v1/tts/inference

# Voice usage protection
VOICE_MAX_UPLOAD_BYTES=5242880
VOICE_MAX_DURATION_SECONDS=30
VOICE_USAGE_LIMIT_SECONDS=300

# LLM provider
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Live flight search — keep the API key in backend/.env only
SERPAPI_API_KEY=
SERPAPI_TIMEOUT_SECONDS=35

# Browser agent demo — no external key is required
AGENT_DEMO_MODE=true
AGENT_BROWSER_CDP_URL=
AGENT_DEMO_BASE_URL=http://127.0.0.1:8000
AGENT_ALLOWED_DOMAINS=127.0.0.1,localhost
AGENT_TIMEOUT_SECONDS=300
AGENT_APPROVAL_TIMEOUT_SECONDS=600

# Existing optional travel providers
GEOAPIFY_API_KEY=
DUFFEL_API_KEY=
STAYAPI_KEY=
REEF_API_KEY=

# Swiggy integration — disabled/mock by default
SWIGGY_MODE=mock
SWIGGY_CLIENT_ID=
SWIGGY_TOKEN_ENCRYPTION_KEY=
SWIGGY_REDIRECT_URI=http://localhost:8000/api/integrations/swiggy/oauth/callback
SWIGGY_FRONTEND_RETURN_URL=http://localhost:5173/settings
SWIGGY_AUTHORIZE_URL=https://mcp.swiggy.com/auth/authorize
SWIGGY_TOKEN_URL=https://mcp.swiggy.com/auth/token
SWIGGY_LOGOUT_URL=https://mcp.swiggy.com/auth/logout
SWIGGY_OAUTH_SCOPE=mcp:tools
