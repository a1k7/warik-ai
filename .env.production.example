# Copy to .env.production and edit before starting Docker Compose.
# Run: docker compose --env-file .env.production -f docker-compose.production.yml up -d --build
# Never commit .env.production or paste provider secrets into the frontend.

POSTGRES_DB=warik
POSTGRES_USER=warik
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_URL_SAFE_PASSWORD

# Public HTTPS origins. These must match the real DNS/TLS endpoints.
CORS_ORIGINS=https://app.example.com
VITE_API_BASE_URL=https://api.example.com/api

# Bind to loopback when a TLS reverse proxy runs on this host.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8080
BACKEND_BIND=127.0.0.1
BACKEND_PORT=8000

# Required production authentication secret (32+ random characters).
JWT_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Hosted LLM; choose groq or ollama. Groq is the hosted deployment path.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional speech provider. Voice stays disabled unless explicitly enabled.
VOICE_ENABLED=false
GNANI_API_KEY=
GNANI_ORG_ID=
GNANI_USER_ID=

# Duffel search/refresh only — not ticket issuing or payment.
DUFFEL_API_KEY=

# Optional Booking.com Demand API partner access.
BOOKING_MODE=disabled
BOOKING_API_BASE_URL=https://demandapi.booking.com/3.3
BOOKING_API_TOKEN=
BOOKING_AFFILIATE_ID=

# Swiggy mock mode is not live ordering.
SWIGGY_MODE=mock
SWIGGY_CLIENT_ID=
SWIGGY_TOKEN_ENCRYPTION_KEY=
